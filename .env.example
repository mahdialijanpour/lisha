# Copy to .env. Do not commit .env or use VITE_ for secrets. Restart the server after changes.
LISHA_DATA_DIR=data
# Production must use the public HTTPS address of this server.
LISHA_PUBLIC_URL=https://lishaspace.com
LISHA_SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Local Vite only: leave SMS driver unset or set development.
# Codes are written privately under data/development-otp; never returned by the API.

# Optional presentation demo: enable explicitly; use an empty, persistent data directory.
# Fixed login is disabled by default, including in production.
LISHA_DEMO_AUTH=false
LISHA_DEMO_ADMIN_PHONE=
LISHA_DEMO_ADMIN_CODE=
LISHA_DEMO_CUSTOMER_PHONE=
LISHA_DEMO_CUSTOMER_CODE=
# On a fresh host, LISHA_DATA_DIR=data works. npm start imports demo-catalog/ once.
# To initialize an existing empty database explicitly: npm run demo:setup
# To keep local real data separate, use LISHA_DATA_DIR=.sites-local/demo instead.
