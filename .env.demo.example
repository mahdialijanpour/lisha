# Presentation demo only. Copy to .env or enter these values in the host environment.
# Replace this URL with the exact public HTTPS domain used to open the demo.
NODE_ENV=production
LISHA_PUBLIC_URL=https://demo.example.com
LISHA_DATA_DIR=data
LISHA_DEMO_AUTH=true
LISHA_DEMO_ADMIN_PHONE=09999990001
LISHA_DEMO_ADMIN_CODE=735291
LISHA_DEMO_CUSTOMER_PHONE=09999990002
LISHA_DEMO_CUSTOMER_CODE=426815
# The hosting provider may set PORT itself. Data must reside on persistent storage.
# Admin: /admin/ ; customer: /my-account/ . No SMS or real payments in demo mode.
